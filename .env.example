# Copiez ce fichier en ".env" (meme dossier que docker-compose.yml) et remplissez.
# NE COMMITEZ JAMAIS le fichier .env reel (mot de passe en clair).

EDOCPERSO_EMAIL=votre.email@exemple.fr
EDOCPERSO_PASSWORD=votre_mot_de_passe_edocperso

PAPERLESS_URL=https://paperless.example.com
PAPERLESS_TOKEN=votre_token_api_paperless

# Tag Paperless applique aux documents importes (cree automatiquement si absent)
EDOCPERSO_TAG=edocperso
